{
  // 設定ファイルとテスト（Node で動く）
  "include": ["vite.config.ts", "vitest.config.ts", "test", "fixtures"],
  // test/worker は Worker の型（Env など）を使うので tsconfig.worker.json で見る
  "exclude": ["test/worker"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "resolveJsonModule": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
