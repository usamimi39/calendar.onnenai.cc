{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar-onnenai-cc",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // 本番の KV（2026-11-26 作成）。ローカル開発（pnpm dev）は miniflare のローカル KV を使うので本番には触らない
  "kv_namespaces": [{ "binding": "BUSY_KV", "id": "685e792cfcb445bca82885d72ed06274" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": { "TIMEZONE": "Asia/Tokyo" },
  "routes": [{ "pattern": "calendar.onnenai.cc", "custom_domain": true }],
  // console.* に予定やIDを出さない前提。リクエストのメタ情報だけが残る
  "observability": { "enabled": true },
}
